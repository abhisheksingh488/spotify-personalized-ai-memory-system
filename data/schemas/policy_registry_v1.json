{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spotify Memory Policy Registry",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "default_policy",
    "policies"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "default_policy": {
      "type": "string",
      "enum": [
        "STANDARD"
      ]
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_class",
          "persistence_allowed",
          "retrieval_allowed",
          "user_control_required"
        ],
        "properties": {
          "policy_class": {
            "type": "string",
            "enum": [
              "STANDARD",
              "SENSITIVE",
              "BLOCKED"
            ]
          },
          "persistence_allowed": {
            "type": "boolean"
          },
          "retrieval_allowed": {
            "type": "boolean"
          },
          "user_control_required": {
            "type": "boolean"
          },
          "retention_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}