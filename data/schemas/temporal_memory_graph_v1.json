{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spotify Temporal Memory Graph",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_version",
    "nodes",
    "relationships"
  ],
  "properties": {
    "graph_version": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "node_type",
          "subject_id",
          "created_at"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "node_type": {
            "type": "string",
            "enum": [
              "Subject",
              "Memory",
              "Artist",
              "Track",
              "Album",
              "Playlist",
              "Genre",
              "Entity"
            ]
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "properties": {
            "type": "object"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "superseded",
              "deleted"
            ]
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relationship_id",
          "from_node",
          "to_node",
          "relationship_type",
          "created_at"
        ],
        "properties": {
          "relationship_id": {
            "type": "string",
            "minLength": 1
          },
          "from_node": {
            "type": "string",
            "minLength": 1
          },
          "to_node": {
            "type": "string",
            "minLength": 1
          },
          "relationship_type": {
            "type": "string",
            "enum": [
              "HAS_MEMORY",
              "PREFERS",
              "DISLIKES",
              "LIKES",
              "MENTIONS",
              "RELATED_TO",
              "SUPERSEDES",
              "DERIVED_FROM"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provenance": {
            "type": "object"
          }
        }
      }
    }
  }
}