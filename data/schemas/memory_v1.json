{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spotify Personalized Memory",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_id",
    "subject_id",
    "memory_type",
    "fact_text",
    "confidence",
    "policy_class",
    "source",
    "valid_from"
  ],
  "properties": {
    "memory_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "memory_type": {
      "type": "string",
      "enum": [
        "EXPLICIT_PREFERENCE",
        "CANDIDATE_PREFERENCE",
        "CORRECTION",
        "CONTEXTUAL_FACT"
      ]
    },
    "fact_text": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "policy_class": {
      "type": "string",
      "enum": [
        "STANDARD",
        "SENSITIVE",
        "BLOCKED"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "deleted"
      ]
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}