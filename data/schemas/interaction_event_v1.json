{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spotify Memory Interaction Event",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "subject_id",
    "event_type",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "chat_message",
        "explicit_preference",
        "memory_correction",
        "memory_deletion",
        "feedback"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "consent": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}